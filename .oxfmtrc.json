{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["*.data.ts", "*.js", "docs/assets/**/*.scss"],
	"semi": false,
	"singleQuote": true,
	"useTabs": true,
	"tabWidth": 4,
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"sortImports": {
		"newlinesBetween": false
	},
	"overrides": [
		{
			"files": ["docs/**"],
			"options": {
				// The theme compresses HTML onto single lines, so semicolon is required.
				"semi": true
			}
		}
	]
}
