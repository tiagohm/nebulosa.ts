{
	"name": "nebulosa",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"module": "main.ts",
	"scripts": {
		"postinstall": "bun run postinstall.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"index": "bun run scripts/codebase.index.ts",
		"review": "bun run scripts/review/review.ts",
		"docs:serve": "cd docs && bundle exec jekyll serve --livereload",
		"docs:build": "cd docs && bundle exec jekyll build"
	},
	"devDependencies": {
		"oxfmt": "latest",
		"oxlint": "latest",
		"oxlint-tsgolint": "latest"
	},
	"peerDependencies": {
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
